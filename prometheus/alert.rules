groups:
- name: finsec.localdomain
  rules:

  # Alert for any instance that is unreachable for >10 minutes.
  - alert: service_down
    expr: up == 0
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} down"
      description: "{{ $labels.instance }} has been down for more than 30 minutes."

  - alert: http_service_down
    expr: probe_http_status_code != 200 and probe_http_status_code != 0
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} HTTP Status is not OK"
      description: "{{ $labels.instance }} of has been not returning 200-OK for more than 5 minutes."

  - alert: high_machine_load
    expr: rate(node_load1[600s]) > 1.8
    for: 10m
    labels:
      severity: page 
    annotations:
      summary: "{{ $labels.instance }} under high load"
      description: "{{ $labels.instance }} is under high load."

  - alert: high_service_load
    expr: rate(container_cpu_user_seconds_total[600s]) > 2.1
    for: 5m
    labels:
      severity: page 
    annotations:
      summary: "{{ $labels.container_label_com_docker_swarm_service_name }} {{ $labels.instance }} under high load"
      description: "{{ $labels.instance }} is under high load. taks id is {{ $labels.id }}. container {{ $labels.container_label_com_docker_swarm_service_name }} of stack {{ $labels.container_label_com_docker_stack_namespace }}. Fullname is {{ $labels.name }}"

  - alert: low_disk_space
    expr: node_filesystem_free_bytes/node_filesystem_size_bytes*100 < 10
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} has < 10% disk space left"
      description: "{{ $labels.instance }} is low on disk space."


  # Timeshift backups (host, root cron 01:00 daily; metrics from scripts/timeshift-metrics.sh every 15 min via the node-exporter textfile collector)
  - alert: timeshift_backup_failed
    expr: timeshift_last_run_failed == 1
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "Timeshift backup failed on {{ $labels.instance }}"
      description: "The newest Timeshift run did not finish with 'Snapshot saved successfully' (see /var/log/timeshift)."

  - alert: timeshift_backup_stale
    expr: time() - timeshift_last_snapshot_timestamp_seconds > 36 * 3600
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "No Timeshift snapshot for more than 36 hours on {{ $labels.instance }}"
      description: "The last Timeshift snapshot is older than 36 hours (the backup runs daily at 01:00)."

  - alert: timeshift_metrics_missing
    expr: time() - timeshift_metrics_updated_timestamp_seconds > 3600 or absent(timeshift_metrics_updated_timestamp_seconds)
    for: 15m
    labels:
      severity: page
    annotations:
      summary: "Timeshift backup monitoring is not reporting"
      description: "timeshift.prom has not been updated for over an hour: check the cron job scripts/timeshift-metrics.sh and the node-exporter textfile mount."
