groups:
- name: finsec.localdomain
  rules:

  # Alert for any instance that is unreachable for >10 minutes.
  - alert: service_down
    expr: up == 0
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} down"
      description: "{{ $labels.instance }} has been down for more than 30 minutes."

  - alert: http_service_down
    expr: probe_http_status_code != 200 and probe_http_status_code != 0
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} HTTP Status is not OK"
      description: "{{ $labels.instance }} of has been not returning 200-OK for more than 5 minutes."

  - alert: high_machine_load
    expr: rate(node_load1[600s]) > 1.8
    for: 10m
    labels:
      severity: page 
    annotations:
      summary: "{{ $labels.instance }} under high load"
      description: "{{ $labels.instance }} is under high load."

  - alert: high_service_load
    expr: rate(container_cpu_user_seconds_total[600s]) > 2.1
    for: 5m
    labels:
      severity: page 
    annotations:
      summary: "{{ $labels.container_label_com_docker_swarm_service_name }} {{ $labels.instance }} under high load"
      description: "{{ $labels.instance }} is under high load. taks id is {{ $labels.id }}. container {{ $labels.container_label_com_docker_swarm_service_name }} of stack {{ $labels.container_label_com_docker_stack_namespace }}. Fullname is {{ $labels.name }}"

  - alert: low_disk_space
    expr: node_filesystem_free_bytes/node_filesystem_size_bytes*100 < 10
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} has < 10% disk space left"
      description: "{{ $labels.instance }} is low on disk space."

  # Linux software RAID (host mdraid, node-exporter md collector). Mail from mdadm --monitor is a second, independent path.
  - alert: mdraid_degraded
    expr: >
      node_md_disks{state="failed"} > 0
      or (node_md_disks_required - ignoring(state) node_md_disks{state="active"}) > 0
      or node_md_state{state="inactive"} == 1
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "RAID array {{ $labels.device }} on {{ $labels.instance }} is degraded"
      description: "{{ $labels.device }} has a failed or missing member, or is inactive. Check /proc/mdstat and 'mdadm --detail /dev/{{ $labels.device }}'."

  - alert: mdraid_metrics_missing
    expr: absent(node_md_disks_required)
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "RAID monitoring is not reporting"
      description: "No node_md_* metrics for 30 minutes: check prometheus-node-exporter and its scrape job, or the array is gone."


  # Timeshift backups (host, root cron 01:00 daily; metrics from scripts/timeshift-metrics.sh every 15 min via the node-exporter textfile collector)
  - alert: timeshift_backup_failed
    expr: timeshift_last_run_failed == 1
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "Timeshift backup failed on {{ $labels.instance }}"
      description: "The newest Timeshift run did not finish with 'Snapshot saved successfully' (see /var/log/timeshift)."

  - alert: timeshift_backup_stale
    expr: time() - timeshift_last_snapshot_timestamp_seconds > 36 * 3600
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "No Timeshift snapshot for more than 36 hours on {{ $labels.instance }}"
      description: "The last Timeshift snapshot is older than 36 hours (the backup runs daily at 01:00)."

  - alert: timeshift_metrics_missing
    expr: time() - timeshift_metrics_updated_timestamp_seconds > 3600 or absent(timeshift_metrics_updated_timestamp_seconds)
    for: 15m
    labels:
      severity: page
    annotations:
      summary: "Timeshift backup monitoring is not reporting"
      description: "timeshift.prom has not been updated for over an hour: check the cron job scripts/timeshift-metrics.sh and the node-exporter textfile mount."

  # Database dumps for Timeshift (scripts/db-dump.sh, ubuntu cron 00:30 daily, dumps in /home/ubuntu/db-dumps; metrics via the textfile collector)
  - alert: db_dump_failed
    expr: db_dump_last_run_failed == 1
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "Database dump of {{ $labels.container }} failed"
      description: "The latest dump of {{ $labels.container }} failed; the previous dump is still in /home/ubuntu/db-dumps. See /home/ubuntu/db-dumps/db-dump.log."

  - alert: db_dump_stale
    expr: time() - db_dump_last_success_timestamp_seconds > 36 * 3600
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "No database dump of {{ $labels.container }} for more than 36 hours"
      description: "The last successful dump of {{ $labels.container }} is older than 36 hours (it runs daily at 00:30), so the Timeshift snapshot has no fresh copy."

  - alert: db_dump_metrics_missing
    expr: time() - db_dump_metrics_updated_timestamp_seconds > 36 * 3600 or absent(db_dump_metrics_updated_timestamp_seconds)
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "Database dump monitoring is not reporting"
      description: "db_dump.prom has not been updated for 36 hours: check the cron job scripts/db-dump.sh and the node-exporter textfile mount."
