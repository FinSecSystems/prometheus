groups:
- name: finsec.localdomain
  rules:

  # Alert for any instance that is unreachable for >10 minutes.
  - alert: service_down
    expr: up == 0
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} down"
      description: "{{ $labels.instance }} has been down for more than 30 minutes."

  - alert: http_service_down
    expr: probe_http_status_code != 200 and probe_http_status_code != 0
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} HTTP Status is not OK"
      description: "{{ $labels.instance }} of has been not returning 200-OK for more than 5 minutes."

  - alert: high_machine_load
    expr: rate(node_load1[600s]) > 1.8
    for: 10m
    labels:
      severity: page 
    annotations:
      summary: "{{ $labels.instance }} under high load"
      description: "{{ $labels.instance }} is under high load."

  - alert: high_service_load
    # per container (name!=""): the unfiltered series include the root cgroup id="/" (the whole host) and the systemd slices, which fired this alert for ordinary host work (builds, dumps, upgrades); the host as a whole is covered by high_machine_load
    expr: sum by (instance, name) (rate(container_cpu_user_seconds_total{name!=""}[600s])) > 2.1
    for: 5m
    labels:
      severity: page 
    annotations:
      summary: "Container {{ $labels.name }} under high CPU load"
      description: "Container {{ $labels.name }} ({{ $labels.instance }}) has used more than 2.1 CPU cores (user time) for 15 minutes: {{ $value | printf \"%.1f\" }} cores. Look at docker stats and docker top {{ $labels.name }}."

  - alert: low_disk_space
    # perseus (QNAP): /mnt/ext on md13 is the NAS's 417 MB system partition (93% full by design), not user data
    expr: node_filesystem_free_bytes/node_filesystem_size_bytes*100 < 10 unless on(instance, mountpoint) node_filesystem_size_bytes{instance="192.168.2.8:9100", mountpoint="/mnt/ext"}
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} has < 10% disk space left"
      description: "{{ $labels.instance }} is low on disk space."

  # Linux software RAID (host mdraid, node-exporter md collector). Mail from mdadm --monitor is a second, independent path.
  - alert: mdraid_degraded
    # perseus (QNAP): md9 and md13 are the NAS's internal system mirrors, created for 32 members of which 7 exist (node_md_disks_required=32),
    # so the "missing member" test below is skipped for exactly those two arrays. Failed members and inactive state are still checked on them.
    expr: >
      node_md_disks{state="failed"} > 0
      or ((node_md_disks_required{instance!="192.168.2.8:9100"} or node_md_disks_required{instance="192.168.2.8:9100", device!~"md9|md13"})
          - ignoring(state) node_md_disks{state="active"}) > 0
      or node_md_state{state="inactive"} == 1
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "RAID array {{ $labels.device }} on {{ $labels.instance }} is degraded"
      description: "{{ $labels.device }} has a failed or missing member, or is inactive. Check /proc/mdstat and 'mdadm --detail /dev/{{ $labels.device }}'."

  - alert: mdraid_metrics_missing
    expr: absent(node_md_disks_required)
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "RAID monitoring is not reporting"
      description: "No node_md_* metrics for 30 minutes: check prometheus-node-exporter and its scrape job, or the array is gone."


  # Timeshift backups (host, root cron 01:00 daily; metrics from scripts/timeshift-metrics.sh every 15 min via the node-exporter textfile collector)
  - alert: timeshift_backup_failed
    expr: timeshift_last_run_failed == 1
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "Timeshift backup failed on {{ $labels.instance }}"
      description: "The newest Timeshift run did not finish with 'Snapshot saved successfully' (see /var/log/timeshift)."

  - alert: timeshift_backup_stale
    expr: time() - timeshift_last_snapshot_timestamp_seconds > 36 * 3600
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "No Timeshift snapshot for more than 36 hours on {{ $labels.instance }}"
      description: "The last Timeshift snapshot is older than 36 hours (the backup runs daily at 01:00)."

  - alert: timeshift_metrics_missing
    expr: time() - timeshift_metrics_updated_timestamp_seconds > 3600 or absent(timeshift_metrics_updated_timestamp_seconds)
    for: 15m
    labels:
      severity: page
    annotations:
      summary: "Timeshift backup monitoring is not reporting"
      description: "timeshift.prom has not been updated for over an hour: check the cron job scripts/timeshift-metrics.sh and the node-exporter textfile mount."

  # Hard-linked copy of the newest Timeshift snapshot for the Glacier job (scripts/timeshift-offsite-link.sh, cron 03:30, docs/backups.md, issue #57)
  - alert: timeshift_offsite_copy_stale
    expr: timeshift_offsite_copy_ok == 0 or time() - timeshift_offsite_copy_snapshot_timestamp_seconds > 48 * 3600 or absent(timeshift_offsite_copy_ok)
    for: 2h
    labels:
      severity: warning
    annotations:
      summary: "The off-site copy of the newest Timeshift snapshot is missing or older than 48 hours"
      description: "scripts/timeshift-offsite-link.sh did not link the newest snapshot into /Backup/TimeShift/grimlock/offsite (see ~/timeshift-offsite-link.log); the Glacier job would upload an old snapshot."

  # Restore tests of the database dumps (scripts/db-restore-test.sh, cron Sundays 05:15, docs/backups.md, issue #58)
  - alert: db_restore_test_failed
    expr: db_restore_test_ok == 0
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "Restore test of {{ $labels.db }} failed"
      description: "The newest dump of {{ $labels.db }} in the offsite Timeshift copy could not be restored into a throwaway container (or, for vaultwarden-export, the export is missing or not valid). See ~/db-restore-test.log."

  - alert: db_restore_test_stale
    expr: time() - db_restore_test_last_success_timestamp_seconds > 60 * 86400 or absent(db_restore_test_last_success_timestamp_seconds)
    for: 1d
    labels:
      severity: warning
    annotations:
      summary: "No successful restore test of {{ $labels.db }} for 60 days"
      description: "The weekly rotation tests four databases per run, so every database should be tested about every five weeks. Check the cron job and ~/db-restore-test.log."

  # TLS certificates of finsec.localdomain and liquibrium.localdomain (scripts/renew-certs.sh, cron 04:40 daily, docs/certificates.md)
  - alert: cert_expiring_soon
    expr: cert_expiry_min_days < 7
    for: 1h
    labels:
      severity: page
    annotations:
      summary: "A {{ $labels.domain }} certificate expires in {{ $value }} days"
      description: "scripts/renew-certs.sh should have renewed it 14 days before expiry. Run it by hand (scripts/renew-certs.sh --check, see ~/renew-certs.log); the CA container or the edge proxy may be down."

  - alert: cert_renewal_failed
    expr: cert_renew_failed > 0
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "Certificate renewal for {{ $labels.domain }} failed ({{ $value }} problems)"
      description: "See ~/renew-certs.log: the CA did not answer, the new certificate did not check out, or the proxy could not be reloaded."

  - alert: cert_renew_stale
    expr: time() - cert_renew_last_run_timestamp_seconds > 36 * 3600 or absent(cert_renew_last_run_timestamp_seconds)
    for: 2h
    labels:
      severity: warning
    annotations:
      summary: "The certificate renewal job has not run for 36 hours"
      description: "Check the cron job of scripts/renew-certs.sh and ~/renew-certs.log (it skips quietly while /mnt/storage is not mounted)."

  # Network ports of the host (node-exporter; eth1 and eth2 are 2.5 Gbit/s ports of the bridge br0, eth0 is deliberately unplugged), docs/network.md
  - alert: nic_link_down
    # perseus (QNAP) eth1 is an unused port (no carrier and 0 bytes since boot; eth2 and eth3 carry the traffic), so it is skipped
    expr: node_network_carrier{device=~"eth[12]"} == 0 unless on(instance, device) node_network_carrier{instance="192.168.2.8:9100", device="eth1"}
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "Network port {{ $labels.device }} has no link on {{ $labels.instance }}"
      description: "The cable or the switch port of {{ $labels.device }} is down."

  - alert: nic_link_speed_low
    expr: node_network_speed_bytes{device=~"eth[12]"} > 0 and node_network_speed_bytes{device=~"eth[12]"} < 3.125e8
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "Network port {{ $labels.device }} negotiated only {{ $value | humanize }}B/s instead of 2.5 Gbit/s"
      description: "Bad cable, switch port limited to 1 Gbit/s or 100 Mbit/s, or a flapping link. Check `ethtool {{ $labels.device }}` and the cable."

  - alert: nic_errors
    expr: increase(node_network_receive_errs_total{device=~"eth[12]"}[1h]) + increase(node_network_transmit_errs_total{device=~"eth[12]"}[1h]) > 20
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "Network port {{ $labels.device }} counted {{ $value | humanize }} errors in the last hour"
      description: "Receive and transmit errors on a port point to a bad cable or a duplex/speed problem."

  - alert: nic_throughput_low
    expr: nic_iperf_send_bits_per_second{server=~"nas2?|router1"} < 1.5e9 or nic_iperf_receive_bits_per_second{server=~"nas2?|router1"} < 1.5e9
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "iperf3 to {{ $labels.server }} reaches only {{ $value | humanize }}bit/s"
      description: "Daily throughput test to the NAS and to router1 (pfSense) from scripts/nic-iperf.sh. The ports are 2.5 Gbit/s (measured 2.35 Gbit/s to router1 and to the NAS); the other end's own link or load can also be the limit. The COMPUTRON test (a PC that is often off) has no alert; compare it in Grafana."

  - alert: nic_iperf_stale
    expr: time() - nic_iperf_last_success_timestamp_seconds{server=~"nas2?|router1"} > 3 * 86400 or absent(nic_iperf_last_success_timestamp_seconds{server=~"nas2?|router1"})
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "The daily iperf3 throughput test to {{ if $labels.server }}{{ $labels.server }}{{ else }}the NAS or router1{{ end }} has not succeeded for 3 days"
      description: "Check the cron job of scripts/nic-iperf.sh, ~/nic-iperf.log and that the iperf3 server answers. For router1: System > Package Manager > Installed Packages must list iperf and the service must run (it can disappear in a pfSense upgrade, docs/speedtest.md)."

  # Internet speed (Speedtest Tracker, stack speedtest; scripts/speedtest-metrics.sh every 15 min, docs/speedtest.md)
  - alert: internet_speed_low
    expr: speedtest_download_bits_per_second < 100e6
    for: 12h
    labels:
      severity: warning
    annotations:
      summary: "Internet download speed has been below 100 Mbit/s for 12 hours ({{ $value | humanize }}bit/s)"
      description: "Results of the last tests in https://speedtest.finsec.localdomain. Adjust the threshold in alert.rules to your line speed."

  - alert: internet_speedtest_stale
    expr: time() - speedtest_last_result_timestamp_seconds > 2 * 86400
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "No successful internet speed test for 2 days"
      description: "Speedtest Tracker (speedtest-app) tests every 6 hours; check its results page and `docker logs speedtest-app`."

  # Bookmark downloads (stash/bookmark-dl/run.sh, daily 02:30; metrics via the node-exporter textfile collector, docs/stash.md)
  - alert: bookmark_download_stale
    expr: time() - bookmark_dl_last_run_timestamp_seconds > 36 * 3600 or absent(bookmark_dl_last_run_timestamp_seconds)
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "The daily bookmark download has not run for 36 hours"
      description: "Check the cron job and $DATA_DIR/stash/config/bookmark-dl/run.log (stash-app must be running, nextcloud-db must answer)."

  - alert: bookmark_download_site_failing
    expr: bookmark_dl_host_failures >= 5
    for: 1d
    labels:
      severity: warning
    annotations:
      summary: "Downloads from {{ $labels.host }} keep failing ({{ $value }} URLs)"
      description: "yt-dlp cannot fetch {{ $value }} bookmarked URLs from {{ $labels.host }}: the extractor may be broken (rebuild stash with a newer yt-dlp), the site blocks this host (proxy), or the links are dead. See state.json in $DATA_DIR/stash/config/bookmark-dl."

  - alert: bookmark_download_scan_failing
    expr: bookmark_dl_scan_ok == 0
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "Stash could not start the scan after the bookmark downloads"
      description: "scan.py got an error from the Stash API (key in finsec.localdomain/stash/bookmark-dl.env; see run.log). New downloads are not scanned until it works."

  - alert: bookmark_download_enrich_failing
    expr: bookmark_dl_enrich_ok == 0
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "Stash could not add metadata to the bookmark downloads"
      description: "enrich.py failed after the scan (source URL, scrape, Identify, Generate, Auto Tag; see run.log and the stash-app log). New downloads keep the title from yt-dlp only and stay without the tag bookmark-dl-enriched; the next run retries them."

  - alert: library_watch_failing
    expr: library_watch_scan_ok == 0 or library_watch_enrich_ok == 0 or library_watch_trash_ok == 0
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "The 3am Stash library watcher failed to scan or enrich new files"
      description: "watch.sh could not start the scan or enrich.py failed (run.log in $DATA_DIR/stash/config/bookmark-dl, stash-app log). The next run retries the same window."

  - alert: library_watch_not_running
    expr: time() - library_watch_last_run_timestamp_seconds > 36 * 3600 or absent(library_watch_last_run_timestamp_seconds)
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "The Stash library watcher has not run for 36 hours"
      description: "Check the cron job (0 3 * * * watch.sh) and run.log; stash-app must be running."

  # Memory pressure and crash loops. Background: cAdvisor sat at its memory limit and was OOM-killed ~35,000 times while swapping 22 MB/s
  # to the NVMe mirror for months, and nothing noticed (see devops issue #39). Normal swap-out here is ~0 MB/s.
  - alert: swap_thrashing
    expr: rate(node_vmstat_pswpout[10m]) * 4096 > 5e6
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} is swapping out {{ $value | humanize }}B/s for 30 minutes"
      description: "Sustained swap-out above 5 MB/s wears the NVMe drives (22 MB/s is about 2 TB/day). Find the container that is at its memory limit or the process that is growing: 'docker stats', the kernel log (journalctl -k | grep -i oom) and /sys/fs/cgroup/system.slice/docker-*.scope/memory.swap.current."

  - alert: oom_kills_detected
    expr: increase(node_vmstat_oom_kill[30m]) > 0
    labels:
      severity: page
    annotations:
      summary: "{{ $value | humanize }} process(es) OOM-killed on {{ $labels.instance }} in the last 30 minutes"
      description: "The kernel killed a process for lack of memory (a container hitting its limit, or the host). Run journalctl -k and grep for oom-kill or Killed process to see the container (oom_memcg) and the process."

  - alert: container_restart_loop
    # container_start_time_seconds is the creation time and never changes on a restart; the CPU counter resets with every new cgroup
    expr: resets(container_cpu_usage_seconds_total{name!=""}[1h]) > 3
    labels:
      severity: page
    annotations:
      summary: "Container {{ $labels.name }} restarted about {{ $value }} times in the last hour"
      description: "{{ $labels.name }} keeps restarting (restart policy loop, e.g. OOM kills or a crash on start). Look at docker logs and docker inspect of this container, and the kernel log for OOM kills. A normal redeploy counts once."

  # Database dumps for Timeshift (scripts/db-dump.sh, ubuntu cron 00:30 daily, dumps in /home/ubuntu/db-dumps; metrics via the textfile collector)
  - alert: db_dump_failed
    expr: db_dump_last_run_failed == 1
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "Database dump of {{ $labels.container }} failed"
      description: "The latest dump of {{ $labels.container }} failed; the previous dump is still in /home/ubuntu/db-dumps. See /home/ubuntu/db-dumps/db-dump.log."

  - alert: db_dump_stale
    expr: time() - db_dump_last_success_timestamp_seconds > 36 * 3600
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "No database dump of {{ $labels.container }} for more than 36 hours"
      description: "The last successful dump of {{ $labels.container }} is older than 36 hours (it runs daily at 00:30), so the Timeshift snapshot has no fresh copy."

  - alert: db_dump_metrics_missing
    expr: time() - db_dump_metrics_updated_timestamp_seconds > 36 * 3600 or absent(db_dump_metrics_updated_timestamp_seconds)
    for: 30m
    labels:
      severity: page
    annotations:
      summary: "Database dump monitoring is not reporting"
      description: "db_dump.prom has not been updated for 36 hours: check the cron job scripts/db-dump.sh and the node-exporter textfile mount."

  # Databases and Redis (exporters in the prometheus stack, issue #18; thresholds are well above normal use: max_connections is 100 to 512)
  - alert: database_down
    expr: pg_up == 0 or mysql_up == 0 or redis_up == 0
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "Database {{ $labels.instance }} is not answering the exporter"
      description: "{{ $labels.instance }} ({{ $labels.job }}) has not accepted a monitoring connection for 5 minutes: the database is down, out of connections, or the exporter user is missing (rerun finsec.localdomain/prometheus/exporters-init.sh)."

  - alert: postgres_connections_high
    expr: sum by (instance) (pg_stat_database_numbackends) / max by (instance) (pg_settings_max_connections) > 0.8
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "{{ $labels.instance }} uses {{ $value | humanizePercentage }} of its connections"
      description: "More than 80% of max_connections are in use for 10 minutes; applications will start to fail with 'too many clients'. Look at pg_stat_activity."

  - alert: mysql_connections_high
    expr: mysql_global_status_threads_connected / mysql_global_variables_max_connections > 0.8
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "{{ $labels.instance }} uses {{ $value | humanizePercentage }} of its connections"
      description: "More than 80% of max_connections are in use for 10 minutes. Look at SHOW PROCESSLIST."

  - alert: redis_rejecting_connections
    expr: increase(redis_rejected_connections_total[10m]) > 0
    labels:
      severity: warning
    annotations:
      summary: "{{ $labels.instance }} rejected {{ $value }} connections in 10 minutes"
      description: "Redis hit maxclients; clients are being refused."

  # Certificates seen by the blackbox probes (https targets; internal CA and public)
  - alert: certificate_expires_soon
    expr: (probe_ssl_earliest_cert_expiry - time()) < 14 * 86400 and probe_ssl_earliest_cert_expiry > 0
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "Certificate of {{ $labels.instance }} expires in {{ $value | humanizeDuration }}"
      description: "The certificate presented by {{ $labels.instance }} expires within 14 days. Internal names: docker exec operations-ca /workdir/generate_cert.sh <host> and reload the proxy; public names: check the Cloudflare/origin certificate."

  - alert: certificate_expires_very_soon
    expr: (probe_ssl_earliest_cert_expiry - time()) < 3 * 86400 and probe_ssl_earliest_cert_expiry > 0
    for: 10m
    labels:
      severity: page
    annotations:
      summary: "Certificate of {{ $labels.instance }} expires in {{ $value | humanizeDuration }}"
      description: "The certificate presented by {{ $labels.instance }} expires within 3 days."

  # Disk: low_disk_space above fires at 10% free; these two give an earlier warning and a trend
  - alert: disk_usage_high
    # perseus (QNAP): /mnt/ext (md13, 417 MB system partition) is excluded, the data volumes are still checked
    expr: (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|nsfs"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|nsfs"}) * 100 > 85 unless on(instance, mountpoint) node_filesystem_size_bytes{instance="192.168.2.8:9100", mountpoint="/mnt/ext"}
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "{{ $labels.mountpoint }} on {{ $labels.instance }} is {{ $value | printf \"%.0f\" }}% full"
      description: "More than 85% used for 30 minutes. Old images (docker image prune), rollback copies (scripts/*cleanup*.sh) and logs are the usual candidates."

  - alert: disk_filling_up
    expr: predict_linear(node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs|ramfs|nsfs"}[6h], 4 * 86400) < 0 and node_filesystem_avail_bytes / node_filesystem_size_bytes < 0.4
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "{{ $labels.mountpoint }} on {{ $labels.instance }} will be full within 4 days at the current rate"
      description: "The last 6 hours of growth extrapolate to a full disk within 4 days (the filesystem is also below 40% free)."

  # Prometheus itself (it cannot alert about being down: the external check is Uptime Kuma / the blackbox probe of prometheus.finsec.localdomain)
  - alert: prometheus_config_reload_failed
    expr: prometheus_config_last_reload_successful == 0
    for: 5m
    labels:
      severity: page
    annotations:
      summary: "Prometheus could not load its configuration"
      description: "The last reload of prometheus.yml or alert.rules failed (docker logs prometheus-app); it keeps running with the old configuration."

  - alert: prometheus_alerts_not_delivered
    expr: rate(prometheus_notifications_errors_total[10m]) > 0 or prometheus_notifications_alertmanagers_discovered < 1
    for: 10m
    labels:
      severity: page
    annotations:
      summary: "Prometheus cannot deliver alerts to Alertmanager"
      description: "Notifications to prometheus-alertmanager fail or no Alertmanager is discovered, so no alert mail is sent."

  - alert: prometheus_restarted
    expr: changes(process_start_time_seconds{job="prometheus"}[30m]) > 0
    labels:
      severity: warning
    annotations:
      summary: "Prometheus restarted in the last 30 minutes"
      description: "prometheus-app was (re)started. Planned (config or image change) restarts are expected; otherwise look at docker inspect prometheus-app and the data directory (local disk since 2026-11-01)."

  # perseus NAS (job 'perseus', node_exporter :9100 and process-exporter :9256 in Container Station). The process alerts name the culprit in the
  # groupname label; grouping is by process name (comm), see /share/Container/monitoring/process-exporter.yml on perseus.
  - alert: perseus_exporter_down
    expr: up{job="perseus"} == 0
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "perseus {{ $labels.exporter }} exporter down"
      description: "Check the perseus-node-exporter / perseus-process-exporter containers in Container Station (ssh perseus, docker ps)."

  - alert: perseus_high_cpu
    expr: 1 - avg(rate(node_cpu_seconds_total{job="perseus",mode="idle"}[5m])) > 0.85
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "perseus CPU above 85% for 30 minutes"
      description: "See the top processes: topk(5, sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total{job=\"perseus\"}[5m])))."

  - alert: perseus_low_memory
    expr: node_memory_MemAvailable_bytes{job="perseus"} / node_memory_MemTotal_bytes{job="perseus"} < 0.1
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "perseus has {{ $value | humanizePercentage }} memory available"
      description: "See the top processes: topk(5, namedprocess_namegroup_memory_bytes{job=\"perseus\",memtype=\"resident\"})."

  - alert: perseus_process_cpu_hog
    expr: sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total{job="perseus"}[5m])) > 1.5
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "perseus process {{ $labels.groupname }} uses {{ $value | humanize }} CPU cores for 30 minutes"
      description: "A single process group is using more than 1.5 cores on perseus."

  - alert: perseus_process_memory_hog
    expr: namedprocess_namegroup_memory_bytes{job="perseus",memtype="resident"} > 4e9
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "perseus process {{ $labels.groupname }} holds {{ $value | humanize1024 }}B resident memory"
      description: "A single process group is holding more than 4 GB of the 16 GB RAM on perseus."

  # router2 (pfSense, CARP backup of router1): node_exporter package (job router2), ping through the blackbox exporter (job router_icmp) and scripts/router-metrics.sh
  # (router_*{host="router2"}, textfile). It lost power abruptly many times (SMART Power-Off_Retract_Count 60 of 66 power cycles on 2026-11-13).
  - alert: router2_unreachable
    expr: probe_success{job="router_icmp",host="router2"} == 0
    for: 3m
    labels:
      severity: warning
    annotations:
      summary: "router2 does not answer ping"
      description: "router2 (192.168.2.254) is off or unreachable. It is the CARP backup, so nothing else breaks while router1 is up; check its power supply (docs/monitoring.md, router2)."

  - alert: router2_rebooted
    expr: changes(node_boot_time_seconds{job="router2"}[15m]) > 0
    labels:
      severity: warning
    annotations:
      summary: "router2 rebooted"
      description: "router2's boot time changed in the last 15 minutes. If router_smart_unsafe_poweroff_count also rose it was a power loss (alert router2_unsafe_poweroff), otherwise a clean reboot or a panic."

  - alert: router2_unsafe_poweroff
    expr: increase(router_smart_unsafe_poweroff_count{host="router2"}[1h]) > 0
    labels:
      severity: warning
    annotations:
      summary: "router2 lost power abruptly (SMART unsafe power-off counter rose)"
      description: "The system SSD's Power-Off_Retract_Count rose, so power to the router was cut without a shutdown. Check its power brick, plug, outlet or strip, and consider a UPS."

  - alert: router2_exporter_down
    expr: up{job="router2"} == 0
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "router2 node_exporter does not answer"
      description: "Check Services > Prometheus node_exporter on router2 (enabled, listen on LAN, port 9100) and that the LAN rule allows TCP 9100 from 192.168.2.69. Ping is a separate probe (router2_unreachable)."

  - alert: router2_metrics_stale
    expr: router_metrics_ok{host="router2"} == 0 or time() - router_metrics_last_success_timestamp_seconds{host="router2"} > 600 or absent(router_metrics_ok{host="router2"})
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "scripts/router-metrics.sh cannot read router2 over SSH"
      description: "The SMART, pf, gateway and process metrics of router2 are not updating. Check the ubuntu cron job, 'ssh admin@router2 true' and ~/data/.../textfile/router_router2.prom."

  - alert: router2_smart_failing
    expr: router_smart_health_ok{host="router2"} == 0 or router_smart_reallocated_sectors{host="router2"} > 0
    labels:
      severity: warning
    annotations:
      summary: "router2 system SSD reports SMART problems"
      description: "Health test failed or sectors were reallocated: smartctl -a /dev/ada0 on router2. Replace the mSATA SSD and restore the pfSense config (Diagnostics > Backup)."

  - alert: router2_high_temperature
    expr: max(router_temperature_celsius{host="router2"}) > 75 or router_smart_temperature_celsius{host="router2"} > 65
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "router2 temperature above the limit"
      description: "A thermal zone is above 75 C or the SSD above 65 C. Check the fan and airflow."

  - alert: router2_high_cpu
    expr: 1 - avg(rate(node_cpu_seconds_total{job="router2",mode="idle"}[5m])) > 0.85
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "router2 CPU above 85% for 30 minutes"
      description: "See the top processes in the Router1 + Router2 Monitoring dashboard (router_process_cpu_percent)."

  - alert: router2_low_memory
    expr: (node_memory_free_bytes{job="router2"} + node_memory_inactive_bytes{job="router2"} + node_memory_cache_bytes{job="router2"}) / node_memory_size_bytes{job="router2"} < 0.10
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "router2 has less than 10% memory free, inactive or cached"
      description: "FreeBSD has no MemAvailable: free + inactive + cache is used (ZFS ARC counts as wired). See router_process_rss_bytes in the Router1 + Router2 Monitoring dashboard (snort and ntopng are the big ones)."

  - alert: router2_disk_filling
    expr: 1 - node_filesystem_avail_bytes{job="router2",mountpoint="/"} / node_filesystem_size_bytes{job="router2",mountpoint="/"} > 0.90
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "router2 root filesystem above 90%"
      description: "The 119 GB pool is filling up (logs, snort, ntopng data); see du on router2."

  - alert: router2_gateway_loss
    expr: router_gateway_loss_ratio{host="router2"} > 0.20
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "router2 gateway {{ $labels.gateway }} loses {{ $value | humanizePercentage }} of its pings"
      description: "dpinger loss on router2 for this gateway (WAN, 4G or an OpenVPN tunnel); the 4G gateway often shows 5-21% for a minute."

  - alert: router2_became_carp_master
    expr: max(router_carp_master{host="router2"}) == 1
    for: 2m
    labels:
      severity: page
    annotations:
      summary: "router2 is CARP MASTER: router1 is not serving"
      description: "router2 is meant to be the backup. It took over, so router1 is down or demoted; check router1 (ssh router1)."

  # router1 (pfSense, CARP MASTER, 192.168.2.253): node_exporter package (job router1), ping (job router_icmp), scripts/router-metrics.sh (router_*{host="router1"}). Its NVMe system disk is worn out (SMART FAILED, 182% used, 1329 of 1417 power cycles unsafe on 2026-11-13).
  - alert: router1_unreachable
    expr: probe_success{job="router_icmp",host="router1"} == 0
    for: 3m
    labels:
      severity: page
    annotations:
      summary: "router1 does not answer ping"
      description: "router1 (192.168.2.253) is off or unreachable. It is the CARP backup, so nothing else breaks while router1 is up; check its power supply (docs/monitoring.md, router1)."

  - alert: router1_rebooted
    expr: changes(node_boot_time_seconds{job="router1"}[15m]) > 0
    labels:
      severity: warning
    annotations:
      summary: "router1 rebooted"
      description: "router1's boot time changed in the last 15 minutes. If router_smart_unsafe_poweroff_count also rose it was a power loss (alert router1_unsafe_poweroff), otherwise a clean reboot or a panic."

  - alert: router1_unsafe_poweroff
    expr: increase(router_smart_unsafe_poweroff_count{host="router1"}[1h]) > 0
    labels:
      severity: warning
    annotations:
      summary: "router1 lost power abruptly (SMART unsafe power-off counter rose)"
      description: "The system SSD's Power-Off_Retract_Count rose, so power to the router was cut without a shutdown. Check its power brick, plug, outlet or strip, and consider a UPS."

  - alert: router1_exporter_down
    expr: up{job="router1"} == 0
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "router1 node_exporter does not answer"
      description: "Check Services > Prometheus node_exporter on router1 (enabled, listen on LAN, port 9100) and that the LAN rule allows TCP 9100 from 192.168.2.69. Ping is a separate probe (router1_unreachable)."

  - alert: router1_metrics_stale
    expr: router_metrics_ok{host="router1"} == 0 or time() - router_metrics_last_success_timestamp_seconds{host="router1"} > 600 or absent(router_metrics_ok{host="router1"})
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "scripts/router-metrics.sh cannot read router1 over SSH"
      description: "The SMART, pf, gateway and process metrics of router1 are not updating. Check the ubuntu cron job, 'ssh admin@router1 true' and ~/data/.../textfile/router_router1.prom."

  - alert: router1_smart_failing
    expr: router_smart_health_ok{host="router1"} == 0 or router_smart_critical_warning{host="router1"} > 0 or router_smart_media_errors{host="router1"} > 0 or router_smart_percentage_used{host="router1"} > 100
    labels:
      severity: page
    annotations:
      summary: "router1 NVMe system disk is failing or worn out (SMART)"
      description: "smartctl -a /dev/nvme0 on router1: critical warning, failed health test, media errors or more than 100% of the rated endurance used. Back up the pfSense config (Diagnostics > Backup) and replace the disk; router2 holds a synced copy."

  - alert: router1_high_temperature
    expr: max(router_temperature_celsius{host="router1"}) > 75 or router_smart_temperature_celsius{host="router1"} > 70
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "router1 temperature above the limit"
      description: "A thermal zone is above 75 C or the NVMe above its 70 C warning threshold. Check the fan and airflow."

  - alert: router1_high_cpu
    expr: 1 - avg(rate(node_cpu_seconds_total{job="router1",mode="idle"}[5m])) > 0.85
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "router1 CPU above 85% for 30 minutes"
      description: "See the top processes in the Router1 + Router2 Monitoring dashboard (router_process_cpu_percent)."

  - alert: router1_low_memory
    expr: (node_memory_free_bytes{job="router1"} + node_memory_inactive_bytes{job="router1"} + node_memory_cache_bytes{job="router1"}) / node_memory_size_bytes{job="router1"} < 0.10
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "router1 has less than 10% memory free, inactive or cached"
      description: "FreeBSD has no MemAvailable: free + inactive + cache is used (ZFS ARC counts as wired). See router_process_rss_bytes in the Router1 + Router2 Monitoring dashboard (snort and ntopng are the big ones)."

  - alert: router1_disk_filling
    expr: 1 - node_filesystem_avail_bytes{job="router1",mountpoint="/"} / node_filesystem_size_bytes{job="router1",mountpoint="/"} > 0.90
    for: 30m
    labels:
      severity: warning
    annotations:
      summary: "router1 root filesystem above 90%"
      description: "The pool is filling up (logs, snort, ntopng data); see du on router1."

  - alert: router1_gateway_loss
    expr: router_gateway_loss_ratio{host="router1"} > 0.20
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "router1 gateway {{ $labels.gateway }} loses {{ $value | humanizePercentage }} of its pings"
      description: "dpinger loss on router1 for this gateway (WAN, 4G or an OpenVPN tunnel); the 4G gateway often shows 5-21% for a minute."

  - alert: router1_not_carp_master
    expr: max(router_carp_master{host="router1"}) == 0
    for: 2m
    labels:
      severity: page
    annotations:
      summary: "router1 is not CARP MASTER: router2 is serving (or nobody is)"
      description: "router1 is meant to be the master. It was demoted or lost its interfaces; check ssh router1 and ifconfig | grep carp, and whether router2 took over (alert router2_became_carp_master)."

  # pfSense config backup (scripts/router-config-backup.sh, ubuntu cron daily 03:40, copies in ~/router-backups/<router>/, docs/backups.md). router2 is not covered yet (GitHub issue).
  - alert: router_config_backup_stale
    expr: time() - router_config_backup_last_success_timestamp_seconds{host="router1"} > 129600 or router_config_backup_ok{host="router1"} == 0 or absent(router_config_backup_last_success_timestamp_seconds{host="router1"})
    for: 1h
    labels:
      severity: warning
    annotations:
      summary: "no successful pfSense config backup of router1 for 36 hours"
      description: "scripts/router-config-backup.sh could not copy router1's /conf/config.xml (router down, key removed, hash or XML check failed). See ~/router-config-backup.log. router1's NVMe is failing, so this backup is the recovery path."

  # Hardware temperatures and fans (node-exporter hwmon; limits are the ones the chips report themselves, see docs/monitoring.md).
  # The chip ids: nvme_nvme*, pci0000:00_0000:00:18_3 = Ryzen CPU (k10temp), 0000:02:00_0_0000:03:00_0 = Radeon AI PRO R9700, platform_f71882fg_2592 = perseus board.
  - alert: hardware_temp_critical
    expr: node_hwmon_temp_celsius >= on(instance, chip, sensor) node_hwmon_temp_crit_celsius
    for: 2m
    labels:
      severity: page
    annotations:
      summary: "{{ $labels.instance }} {{ $labels.chip }}/{{ $labels.sensor }} at {{ $value | printf \"%.0f\" }} C, above its critical limit"
      description: "The sensor reports a temperature at or above the critical limit of the chip (the hardware throttles or shuts down). Check fans and airflow."

  - alert: hardware_temp_high
    expr: node_hwmon_temp_celsius >= on(instance, chip, sensor) (node_hwmon_temp_max_celsius < 1000)
    for: 10m
    labels:
      severity: warning
    annotations:
      summary: "{{ $labels.instance }} {{ $labels.chip }}/{{ $labels.sensor }} at {{ $value | printf \"%.0f\" }} C, above its maximum"
      description: "The temperature has been above the maximum the chip reports (NVMe warning temperature, CPU/board max) for 10 minutes."

  # The Ryzen 7 5700G on this host reports no limit; AMD specifies Tjmax 95 C.
  - alert: cpu_temp_tjmax
    expr: node_hwmon_temp_celsius{chip="pci0000:00_0000:00:18_3", host=""} >= 95
    for: 2m
    labels:
      severity: page
    annotations:
      summary: "CPU of {{ $labels.instance }} at {{ $value | printf \"%.0f\" }} C (Tjmax 95 C)"
      description: "The Ryzen 7 5700G reached its maximum junction temperature (AMD specification 95 C) and throttles."

  - alert: gpu_fan_at_max
    expr: node_hwmon_fan_rpm >= on(instance, chip, sensor) (node_hwmon_fan_max_rpm * 0.95)
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "GPU fan of {{ $labels.instance }} at {{ $value | printf \"%.0f\" }} RPM, at its maximum"
      description: "The fan has been at 95% of its rated maximum speed for 5 minutes: the card cannot shed its heat."

  - alert: gpu_fan_stopped_hot
    expr: node_hwmon_fan_rpm{chip="0000:02:00_0_0000:03:00_0"} == 0 and on(instance, chip) node_hwmon_temp_celsius{chip="0000:02:00_0_0000:03:00_0", sensor="temp1"} > 70
    for: 3m
    labels:
      severity: page
    annotations:
      summary: "GPU fan of {{ $labels.instance }} stopped while the card is above 70 C"
      description: "The fan reports 0 RPM with the edge temperature above 70 C (the zero-RPM idle mode only applies when cool): the fan has failed or is blocked."
