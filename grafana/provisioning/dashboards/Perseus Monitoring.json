      "targets": [
        {
          "expr": "node_load1{job=\"perseus\"} / count(node_cpu_seconds_total{job=\"perseus\",mode=\"idle\"})",
          "legendFormat": "",
          "refId": "A",
          "datasource": "Prometheus",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
