    {
      "id": 9,
      "type": "timeseries",
      "title": "Node Network Traffic",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum(rate(node_network_receive_bytes_total{job=\"perseus\",device=~\"eth[0-9]+\"}[$interval]))",
          "legendFormat": "receive",
          "refId": "A",
          "datasource": "Prometheus",
          "interval": ""
        },
        {
          "expr": "-sum(rate(node_network_transmit_bytes_total{job=\"perseus\",device=~\"eth[0-9]+\"}[$interval]))",
          "legendFormat": "transmit",
          "refId": "B",
          "datasource": "Prometheus",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
